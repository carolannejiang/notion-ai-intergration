# Notion internal-integration secret (starts with "ntn_" or "secret_")
NOTION_TOKEN=

# Leave unset to run on your Claude subscription (uses your Claude Code login).
# Set an API key to bill the Anthropic API instead.
ANTHROPIC_API_KEY=

# Claude model the agent runs on ("opus", "sonnet", "haiku", or a full model id).
# Leave blank to use your Claude Code default model.
AGENT_MODEL=

# Phrase that summons the agent in a comment (case-insensitive prefix match)
AGENT_TRIGGER=@agent

# Comma-separated Notion page IDs to watch. Leave empty to auto-discover the
# most recently edited pages shared with the integration.
WATCH_PAGE_IDS=

# How many pages to watch when auto-discovering (keep small: every block on
# every watched page is polled for comments)
MAX_DISCOVERED_PAGES=5

# Poll interval in milliseconds
POLL_INTERVAL_MS=60000

# Webhook mode (npm run webhook): local port to listen on
WEBHOOK_PORT=8787

# Webhook signature verification: set to the verification token Notion sends
# when you register the webhook subscription. Leave blank to skip verification.
NOTION_WEBHOOK_SECRET=
